# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Comma separated list of origins allowed to call the lead API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
FUNNEL_VERSION=qualification-v1
# Where the file-backed operational store lives when no database is set.
DATA_DIR=./data
# Postgres connection string. REQUIRED on Vercel/serverless (read-only, ephemeral
# filesystem). When set, the store uses Postgres instead of DATA_DIR. Vercel's
# Neon integration sets POSTGRES_URL, which is also accepted.
DATABASE_URL=
# Vercel Cron authenticates to /api/cron/drain with this. Any long random string.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Meta (Pixel + Conversions API)
# ---------------------------------------------------------------------------
# Pixel id is public by design and is exposed to the browser via VITE_META_PIXEL_ID.
META_PIXEL_ID=
# NEVER expose the access token to the browser. Server-side only.
META_ACCESS_TOKEN=
# Set while validating in Events Manager > Test Events. Remove in production.
META_TEST_EVENT_CODE=
META_API_VERSION=v20.0
# Meta CAPI is skipped entirely when false (useful for local demos).
META_CAPI_ENABLED=true

# ---------------------------------------------------------------------------
# n8n automation layer
# ---------------------------------------------------------------------------
# Production: https://<your-n8n-host>/webhook/lead-to-airtable
# Local demo : http://localhost:4000/mock/n8n/webhook/lead-to-airtable
N8N_WEBHOOK_URL=http://localhost:4000/mock/n8n/webhook/lead-to-airtable
# Shared secret sent as the X-Funnel-Signature header and verified inside n8n.
N8N_WEBHOOK_SECRET=local-dev-secret
N8N_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Airtable (operational CRM)
# ---------------------------------------------------------------------------
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_QUALIFICATION_TABLE=Qualification
AIRTABLE_EVENTS_TABLE=Events
AIRTABLE_AUTOMATION_RUNS_TABLE=Automation Runs

# ---------------------------------------------------------------------------
# Mock mode - lets the whole system run and be demoed without credentials
# ---------------------------------------------------------------------------
# Master switch. When true every outbound integration is simulated + logged.
MOCK_MODE=true
MOCK_META=true
MOCK_N8N=false
MOCK_AIRTABLE=true

# Deliberate failure injection for demonstrating the reliability architecture.
MOCK_AIRTABLE_FAILURE=false
MOCK_N8N_FAILURE=false
MOCK_META_FAILURE=false
# Probabilistic failures (0 = never, 1 = always). Useful for soak demos.
MOCK_FAILURE_RATE=0

# ---------------------------------------------------------------------------
# Outbox worker (retry / dead-letter behaviour)
# ---------------------------------------------------------------------------
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=300000

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_LEADS=10
# A 15-step funnel emits ~20 beacons per user, and users behind corporate NAT
# share one source IP. Too tight a limit here silently deletes analytics.
RATE_LIMIT_MAX_EVENTS=600
# Protects /admin/* . Sent as the x-admin-token header.
ADMIN_API_TOKEN=local-admin-token

# ---------------------------------------------------------------------------
# Frontend (Vite). Only VITE_* variables reach the browser bundle.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_META_PIXEL_ID=
VITE_FUNNEL_VERSION=qualification-v1
# Logs every tracking call to the console instead of requiring a real pixel.
VITE_TRACKING_DEBUG=true
# NOTE: there is deliberately no VITE_ADMIN_TOKEN. A VITE_-prefixed variable is
# inlined into the public bundle, so the admin token is typed into /admin at
# runtime and kept in sessionStorage instead.
